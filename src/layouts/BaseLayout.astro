---
import '../styles/global.css';
import SiteSearch from '../components/search/SiteSearch.tsx';
const { title = 'Chroma — HS108 Colour Catalogue' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const links = [['Catalogue','/'],['Scales','/scales'],['Engineered','/engineered'],['Compare','/compare'],['Gradients','/gradients'],['Contrast','/contrast']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="HS108 static colour catalogue and studio tools."/><title>{title}</title></head>
<body><div class="shell"><header class="site-header"><a class="brand" href={`${base}/`}>CHROMA</a><div class="header-tools"><SiteSearch client:load base={base}/><nav class="nav" aria-label="Main navigation">{links.map(([label, href]) => <a href={`${base}${href}`} aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav></div></header><main class="page"><slot /></main></div><div class="swatch-fullscreen" aria-hidden="true"><button class="swatch-fullscreen-close" type="button" aria-label="Close fullscreen">×</button><button class="swatch-fullscreen-play" type="button" aria-label="Pause gradient">Pause</button><div class="swatch-fullscreen-content"></div></div><script is:inline>
  (() => {
    const overlay = document.querySelector('.swatch-fullscreen');
    const content = overlay?.querySelector('.swatch-fullscreen-content');
    const close = overlay?.querySelector('.swatch-fullscreen-close');
    const play = overlay?.querySelector('.swatch-fullscreen-play');
    if (!overlay || !content || !close || !play) return;
    const exit = () => { overlay.classList.remove('is-open'); overlay.setAttribute('aria-hidden', 'true'); content.replaceChildren(); const exitFullscreen = document.exitFullscreen || document.webkitExitFullscreen; if (document.fullscreenElement || document.webkitFullscreenElement) exitFullscreen?.call(document).catch?.(() => {}); };
    const open = (source) => {
      const compareGrid = source.closest('.tool-grid');
      const swatches = compareGrid?.querySelectorAll(':scope > .panel > .swatch');
      const selected = swatches?.length >= 2 && source.closest('.compare-page') ? [...swatches] : [source];
      content.replaceChildren(...selected.map((swatch) => { const clone = swatch.cloneNode(true); clone.classList.add('fullscreen-swatch'); clone.querySelector('.fullscreen-trigger')?.remove(); return clone; })); content.classList.remove('is-paused'); play.textContent = 'Pause'; play.setAttribute('aria-label', 'Pause gradient');
      overlay.classList.add('is-open'); overlay.setAttribute('aria-hidden', 'false');
      const requestFullscreen = overlay.requestFullscreen || overlay.webkitRequestFullscreen;
      requestFullscreen?.call(overlay).catch?.(() => {});
    };
    play.addEventListener('click', () => { const paused = content.classList.toggle('is-paused'); play.textContent = paused ? 'Play' : 'Pause'; play.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'} gradient`); });
    document.addEventListener('click', (event) => { const trigger = event.target.closest?.('.fullscreen-trigger'); if (!trigger || trigger.closest('.swatch-fullscreen')) return; const target = trigger.closest('.swatch'); if (!target) return; event.preventDefault(); event.stopPropagation(); open(target); });
    close.addEventListener('click', exit); overlay.addEventListener('click', (event) => { if (event.target === overlay) exit(); }); const fullscreenChanged = () => { if (!document.fullscreenElement && !document.webkitFullscreenElement && overlay.classList.contains('is-open')) exit(); }; document.addEventListener('fullscreenchange', fullscreenChanged); document.addEventListener('webkitfullscreenchange', fullscreenChanged); document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && overlay.classList.contains('is-open')) exit(); });
  })();
</script></body></html>
