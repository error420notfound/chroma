---
import '../styles/global.css';
import SiteSearch from '../components/search/SiteSearch.tsx';
const {
  title = 'Chroma — Colour library & studio',
  description = 'Browse colour systems, inspect values, and use them in a focused set of colour tools.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const libraryLinks = [
  ['Browse', '/'],
  ['Hue scales', '/scales'],
  ['Engineered hues', '/engineered'],
];
const toolLinks = [
  ['Compare', '/compare'],
  ['Gradients', '/gradients'],
  ['Contrast', '/contrast'],
];
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><meta
      name="theme-color"
      content="#f6f4f0"
    /><title>{title}</title></head
  >
  <body
    ><a class="skip-link" href="#main-content">Skip to content</a><div class="shell">
      <header class="site-header">
        <a class="brand" href={`${base}/`} aria-label="Chroma home"
          ><span class="brand-mark" aria-hidden="true">◒</span>CHROMA</a
        ><div class="header-tools">
          <SiteSearch client:load base={base} /><nav class="nav" aria-label="Main navigation">
            <div class="nav-group">
              <span class="nav-label">Library</span>{
                libraryLinks.map(([label, href]) => (
                  <a
                    href={`${base}${href}`}
                    aria-current={
                      path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined
                    }
                  >
                    {label}
                  </a>
                ))
              }
            </div><div class="nav-group">
              <span class="nav-label">Workbench</span>{
                toolLinks.map(([label, href]) => (
                  <a
                    href={`${base}${href}`}
                    aria-current={path === href || path.startsWith(href) ? 'page' : undefined}
                  >
                    {label}
                  </a>
                ))
              }
            </div>
          </nav>
        </div>
      </header><main class="page" id="main-content"><slot /></main><footer class="site-footer">
        <a href={`${base}/`}>Chroma</a><span
          >Colour records and tool drafts stay in this browser.</span
        ><a href={`${base}/compare`}>Open workbench →</a>
      </footer>
    </div><div class="swatch-fullscreen" aria-hidden="true">
      <button class="swatch-fullscreen-close" type="button" aria-label="Close fullscreen">×</button
      ><button class="swatch-fullscreen-play" type="button" aria-label="Pause gradient"
        >Pause</button
      ><button class="swatch-fullscreen-nav swatch-fullscreen-prev" type="button" aria-label="Previous hue">‹</button>
      <button class="swatch-fullscreen-nav swatch-fullscreen-next" type="button" aria-label="Next hue">›</button>
      <span class="swatch-fullscreen-status visually-hidden" aria-live="polite"></span>
      <div class="swatch-fullscreen-content"></div>
    </div><script is:inline>
      (() => {
        const overlay = document.querySelector('.swatch-fullscreen');
        const content = overlay?.querySelector('.swatch-fullscreen-content');
        const close = overlay?.querySelector('.swatch-fullscreen-close');
        const play = overlay?.querySelector('.swatch-fullscreen-play');
        const previous = overlay?.querySelector('.swatch-fullscreen-prev');
        const next = overlay?.querySelector('.swatch-fullscreen-next');
        const status = overlay?.querySelector('.swatch-fullscreen-status');
        if (!overlay || !content || !close || !play || !previous || !next || !status) return;
        let returnFocus = null;
        let scaleSwatches = [];
        let scaleIndex = -1;
        let swipeStart = null;
        const render = (swatches) => {
          content.replaceChildren(
            ...swatches.map((swatch) => {
              const clone = swatch.cloneNode(true);
              clone.classList.add('fullscreen-swatch');
              clone.querySelector('.fullscreen-trigger')?.remove();
              return clone;
            }),
          );
        };
        const showScaleStep = (index) => {
          if (!scaleSwatches.length) return;
          scaleIndex = (index + scaleSwatches.length) % scaleSwatches.length;
          const source = scaleSwatches[scaleIndex];
          render([source]);
          const scaleName = source.dataset.scaleName || 'Hue scale';
          const step = source.dataset.scaleStep || `${scaleIndex + 1}`;
          status.textContent = `${scaleName}, step ${step} of ${scaleSwatches.length}`;
        };
        const moveScale = (amount) => {
          if (overlay.classList.contains('is-open') && scaleSwatches.length)
            showScaleStep(scaleIndex + amount);
        };
        const exit = () => {
          overlay.classList.remove('is-open');
          overlay.classList.remove('is-scale');
          overlay.setAttribute('aria-hidden', 'true');
          content.replaceChildren();
          status.textContent = '';
          scaleSwatches = [];
          scaleIndex = -1;
          const exitFullscreen = document.exitFullscreen || document.webkitExitFullscreen;
          if (document.fullscreenElement || document.webkitFullscreenElement)
            exitFullscreen?.call(document).catch?.(() => {});
          returnFocus?.focus?.();
          returnFocus = null;
        };
        const open = (source) => {
          const scale = source.closest('.detail-scale');
          if (scale) {
            scaleSwatches = [...scale.querySelectorAll('.scale-step .swatch')];
            scaleIndex = scaleSwatches.indexOf(source);
            overlay.classList.add('is-scale');
            showScaleStep(scaleIndex);
          } else {
            scaleSwatches = [];
            scaleIndex = -1;
            overlay.classList.remove('is-scale');
            const compareGrid = source.closest('.tool-grid');
            const swatches = compareGrid?.querySelectorAll(':scope > .panel > .swatch');
            const selected =
              swatches?.length >= 2 && source.closest('.compare-page') ? [...swatches] : [source];
            render(selected);
            status.textContent = '';
          }
          content.classList.remove('is-paused');
          play.textContent = 'Pause';
          play.setAttribute('aria-label', 'Pause gradient');
          returnFocus = source.querySelector('.fullscreen-trigger');
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
          close.focus();
          const requestFullscreen = overlay.requestFullscreen || overlay.webkitRequestFullscreen;
          requestFullscreen?.call(overlay).catch?.(() => {});
        };
        play.addEventListener('click', () => {
          const paused = content.classList.toggle('is-paused');
          play.textContent = paused ? 'Play' : 'Pause';
          play.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'} gradient`);
        });
        previous.addEventListener('click', () => moveScale(-1));
        next.addEventListener('click', () => moveScale(1));
        content.addEventListener('pointerdown', (event) => {
          swipeStart = event.pointerType === 'mouse' ? null : { x: event.clientX, y: event.clientY };
        });
        content.addEventListener('pointerup', (event) => {
          if (!swipeStart) return;
          const dx = event.clientX - swipeStart.x;
          const dy = event.clientY - swipeStart.y;
          swipeStart = null;
          if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.25) {
            event.preventDefault();
            moveScale(dx < 0 ? 1 : -1);
          }
        });
        document.addEventListener('click', (event) => {
          const trigger = event.target.closest?.('.fullscreen-trigger');
          if (!trigger || trigger.closest('.swatch-fullscreen')) return;
          const target = trigger.closest('.swatch');
          if (!target) return;
          event.preventDefault();
          event.stopPropagation();
          open(target);
        }, true);
        close.addEventListener('click', exit);
        overlay.addEventListener('click', (event) => {
          if (event.target === overlay) exit();
        });
        const fullscreenChanged = () => {
          if (
            !document.fullscreenElement &&
            !document.webkitFullscreenElement &&
            overlay.classList.contains('is-open')
          )
            exit();
        };
        document.addEventListener('fullscreenchange', fullscreenChanged);
        document.addEventListener('webkitfullscreenchange', fullscreenChanged);
        document.addEventListener('keydown', (event) => {
          if (!overlay.classList.contains('is-open')) return;
          if (event.key === 'Escape') exit();
          else if (event.key === 'ArrowLeft' && scaleSwatches.length) {
            event.preventDefault();
            moveScale(-1);
          } else if (event.key === 'ArrowRight' && scaleSwatches.length) {
            event.preventDefault();
            moveScale(1);
          }
        });
      })();
    </script></body
  >
</html>
