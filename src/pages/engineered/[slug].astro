---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { engineeredHues, getEngineeredHue, getScale } from '../../lib/catalogue';
import { contrastSurfaceStyle, cssValues } from '../../lib/colour';
import { CopyButton } from '../../components/colour/CopyButton';
import { Maximize2 } from 'lucide-astro';
export function getStaticPaths() { return engineeredHues.map((hue) => ({ params: { slug: hue.slug } })); }
const hue = getEngineeredHue(Astro.params.slug!);
if (!hue) return Astro.redirect('/engineered');
const related = hue.relatedScaleId ? getScale(hue.relatedScaleId) : undefined;
---
<BaseLayout title={`${hue.name} — Chroma`}><div class="eyebrow">Engineered hue</div><h1>{hue.name}</h1><div class="tool-grid"><section class="panel"><div class="swatch contrast-surface" style={contrastSurfaceStyle(hue.hex, { minHeight: 320 })}><button class="fullscreen-trigger" type="button" aria-label={`View ${hue.name} fullscreen`}><Maximize2 size={18}/></button><span style="font-size:90px">Aa</span><strong>{hue.hex}</strong></div></section><section class="panel"><p>{hue.description}</p><p class="eyebrow">{hue.tags.join(' · ')}</p><hr class="rule"/><div class="meta"><span class="hex">HEX<br/>{hue.hex}</span><CopyButton client:load value={hue.hex}/></div><div class="meta"><span class="hex">OKLCH<br/>{hue.oklch}</span><CopyButton client:load value={hue.oklch}/></div><div class="meta"><span class="hex">Display P3<br/>{hue.p3}</span><CopyButton client:load value={hue.p3}/></div><div style="margin-top:16px"><CopyButton client:load value={cssValues(hue)} label="Copy all CSS values"/></div></section></div>{related && <><hr class="rule"/><div class="panel"><div class="eyebrow">Related scale</div><h2 style="margin-top:8px"><a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/scales/${related.slug}`}>{related.name}</a></h2></div></>}</BaseLayout>
