---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { engineeredHues } from '../../lib/catalogue';
const slug = Astro.params.slug ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
export function getStaticPaths() { return engineeredHues.map((hue) => ({ params: { slug: hue.slug } })); }
---
<BaseLayout title="Moving colour page ? Chroma"><meta http-equiv="refresh" content={`0;url=${base}/engineered/view?slug=${encodeURIComponent(slug)}`} /><p>This colour page moved. <a href={`${base}/engineered/view?slug=${encodeURIComponent(slug)}`}>Continue to the hue</a>.</p><script is:inline define:vars={{ base, slug }}>window.location.replace(`${base}/engineered/view?slug=${encodeURIComponent(slug)}`);</script></BaseLayout>
