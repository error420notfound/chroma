---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hueScales } from '../../lib/catalogue';
const slug = Astro.params.slug ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
export function getStaticPaths() { return hueScales.map((scale) => ({ params: { slug: scale.slug } })); }
---
<BaseLayout title="Moving colour page ? Chroma"><meta http-equiv="refresh" content={`0;url=${base}/scales/view?slug=${encodeURIComponent(slug)}`} /><p>This colour page moved. <a href={`${base}/scales/view?slug=${encodeURIComponent(slug)}`}>Continue to the scale</a>.</p><script is:inline define:vars={{ base, slug }}>window.location.replace(`${base}/scales/view?slug=${encodeURIComponent(slug)}`);</script></BaseLayout>
