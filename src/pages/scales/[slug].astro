---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getScale, hueScales } from '../../lib/catalogue'; import { bestTextColor, contrastRatio } from '../../lib/colour'; import { CopyButton } from '../../components/colour/CopyButton';
export function getStaticPaths(){return hueScales.map(scale=>({params:{slug:scale.slug}}));} const scale=getScale(Astro.params.slug!); if(!scale) return Astro.redirect('/scales');
---
<BaseLayout title={`${scale.name} scale — Chroma`}><div class="scale-detail-page"><div class="eyebrow">{scale.family} hue scale</div><h1>{scale.name}</h1><p class="scale-description">{scale.description}</p><div class="detail-scale">{scale.steps.map(step=><article class="scale-step"><div class="swatch" style={{background:step.hex,color:bestTextColor(step.hex)}}><span>Aa</span><strong>{step.step}</strong></div><div><strong>{step.label}</strong><small>HEX · {step.hex}</small><CopyButton client:load value={step.hex} label="Copy HEX"/><small>OKLCH · {step.oklch}</small><CopyButton client:load value={step.oklch} label="Copy OKLCH"/><small>P3 · {step.p3}</small><CopyButton client:load value={step.p3} label="Copy P3"/></div></article>)}</div>{scale.referenceColors?.length && <><hr class="rule"/><h2>Reference colours</h2><div class="tool-grid reference-grid" style="margin-top:14px">{scale.referenceColors.map(color=><div class="panel"><div class="swatch" style={{background:color.hex,color:bestTextColor(color.hex)}}><strong>{color.name}</strong><span>{color.hex}</span></div></div>)}</div></>}{scale.contrastExamples?.length && <><hr class="rule"/><h2>Contrast examples</h2><div class="tool-grid" style="margin-top:14px">{scale.contrastExamples.map(example=>{const ratio=contrastRatio(example.foreground,example.background);return <div class="panel"><div class="swatch" style={{background:example.background,color:example.foreground}}><strong>Aa</strong><span>{example.label}</span></div><p><strong>{ratio.toFixed(2)}:1</strong> · Normal AA {ratio>=4.5?'Pass':'Fail'} · AAA {ratio>=7?'Pass':'Fail'} · UI {ratio>=3?'Pass':'Fail'}</p></div>})}</div></>}</div></BaseLayout>
