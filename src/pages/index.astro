---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HomeLibrary } from '../components/catalogue/RemoteCatalogueViews';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Chroma — Colour library & studio">
  <section id="library" aria-label="Colour library">
    <h1 class="visually-hidden">Chroma colour library</h1>
    <HomeLibrary client:load base={base} />
  </section>
</BaseLayout>
